{
    "name": "dhananjaysingh/woocommerce-customer-portal",
    "description": "A premium, self-service customer portal for WooCommerce: dashboard, orders, addresses and profile in one place.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/dhananjaysingh/woocommerce-customer-portal",
    "require": {
        "php": ">=7.4",
        "composer/installers": "^1.0 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0",
        "wp-phpunit/wp-phpunit": "^6.5",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^1.11",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "php-stubs/woocommerce-stubs": "^9.0",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "lint": "for f in $(find . -name '*.php' -not -path './vendor/*' -not -path './dist/*'); do php -l \"$f\" > /dev/null || exit 1; done && echo 'PHP lint OK'",
        "phpcs": "phpcs",
        "phpcs:fix": "phpcbf",
        "phpstan": "phpstan analyse --memory-limit=2G",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "test:security": "phpunit --testsuite security",
        "build": "sh scripts/build-plugin.sh",
        "qa": [
            "@lint",
            "@phpcs",
            "@phpstan",
            "@test:all"
        ],
        "test:degraded": "phpunit -c phpunit-degraded.xml.dist",
        "test:all": [
            "@test",
            "@test:degraded"
        ]
    }
}
