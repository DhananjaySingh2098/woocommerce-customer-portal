<?xml version="1.0"?>
<ruleset name="WooCommerce Customer Portal">
	<description>WordPress-Extra + WordPress-Docs, with PHP 7.4 compatibility, over the plugin's runtime PHP.</description>

	<file>.</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/dist/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<!-- Tests are checked separately with a relaxed docs requirement below. -->

	<arg name="extensions" value="php" />
	<arg name="colors" />
	<arg value="sp" />
	<arg name="parallel" value="8" />

	<config name="minimum_supported_wp_version" value="6.0" />
	<config name="testVersion" value="7.4-" />

	<rule ref="WordPress-Extra" />
	<rule ref="WordPress-Docs" />
	<rule ref="PHPCompatibilityWP" />

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="woocommerce-customer-portal" />
			</property>
		</properties>
	</rule>

	<!--
		JUSTIFIED EXCEPTION. The plugin's single, consistently applied prefix is
		`wcp` / `WCP` — on every class, function, hook, constant, option,
		transient and CSS class. WPCS hard-codes a four-character minimum and,
		having rejected the prefix, then reports every global as unprefixed.
		Verified: no `wcp_` / `WCP_` symbol exists in WordPress core or
		WooCommerce, and every plugin global carries the prefix (a grep guard
		for this runs in CI). Renaming every global in the release phase would
		be a risky rewrite to satisfy a heuristic the code already satisfies in
		substance.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>*</exclude-pattern>
	</rule>

	<!--
		Two template helpers are escaping boundaries and are declared as such:
		`wcp_render_template()` returns template output that is escaped at
		source (every template escapes its own values), and `wcp_icon()`
		returns SVG that has been through wp_kses(). Declaring them lets the
		sniff verify everything *else* instead of reporting every line of a
		multi-line call to one of these.
	-->
	<rule ref="WordPress.Security.EscapeOutput">
		<properties>
			<property name="customEscapingFunctions" type="array">
				<element value="wcp_render_template" />
				<element value="wcp_icon" />
			</property>
		</properties>
	</rule>

	<!--
		Templates are `include`d from inside WCP_Helper::render_template(), so
		every variable a template assigns is local to that method call: `$order`,
		`$page`, `$type` and friends here are never the WordPress globals of the
		same name. The sniff cannot see the include context and reports them as
		overrides; they are not.
	-->
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>*/templates/*</exclude-pattern>
		<exclude-pattern>*/admin/views/*</exclude-pattern>
	</rule>

	<!-- `manage_woocommerce` is WooCommerce's capability; WPCS does not know it. -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce" />
			</property>
		</properties>
	</rule>

	<!--
		Tests: method names are their own documentation, and the WordPress test
		framework's own conventions (set_up / tear_down, $_GET manipulation) are
		what they are.
	-->
	<rule ref="Squiz.Commenting.FunctionComment">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<!-- An intentionally empty catch (the redirect we forced) is the point of the test. -->
	<rule ref="Generic.CodeAnalysis.EmptyStatement.DetectedCatch">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<!-- The bootstrap is a CLI entry point: STDERR and the environment are its interface. -->
	<rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_fwrite">
		<exclude-pattern>*/tests/bootstrap.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.runtime_configuration_putenv">
		<exclude-pattern>*/tests/bootstrap.php</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.ClassComment.Missing">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting.DocComment.MissingShort">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.NonceVerification">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.PHP.CommentedOutCode">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Files.OneObjectStructurePerFile">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
</ruleset>
